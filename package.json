{
  "name": "dsh-balance-widget-total",
  "description": "DSH balance & cost widget with LIFETIME total cost. Fork of LL-cmyk-so/dsh-balance-widget: adds a 3rd row showing all-time accumulated cost and tokens, and makes the detail popover opaque with backdrop blur so it no longer overlaps chat text behind it.",
  "version": "0.7.0",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "README.en.md"
  ],
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh": ">=0.1.2-rc.1 <0.3.0"
  },
  "keywords": [
    "deepseek",
    "dsh",
    "deepseek-harness",
    "plugin",
    "balance",
    "cost",
    "token",
    "web-ui",
    "total",
    "cumulative",
    "lifetime"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Torricelli0/dsh-balance-widget2.0.git"
  },
  "bugs": {
    "url": "https://github.com/Torricelli0/dsh-balance-widget2.0/issues"
  },
  "homepage": "https://github.com/Torricelli0/dsh-balance-widget2.0#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@11.7.0"
}
